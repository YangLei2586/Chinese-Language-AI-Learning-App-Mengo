MENGO_APP_ENV=local
MENGO_DEMO_MODE=true
MENGO_DATABASE_URL=sqlite:///./mengo.db
MENGO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
MENGO_AI_PROVIDER_MODE=mock
# Selection defaults are recommendations only. Mock mode makes no external calls.
MENGO_LLM_PROVIDER=openai
MENGO_STT_PROVIDER=deepgram
MENGO_TTS_PROVIDER=elevenlabs
MENGO_LLM_MODEL=gpt-4.1-mini
MENGO_STT_MODEL=nova-3
MENGO_TTS_MODEL=eleven_multilingual_v2
MENGO_TTS_VOICE_ID=
# Keep every commercial-provider credential blank. Production loads reviewed values from Secrets Manager.
MENGO_OPENAI_API_KEY=
MENGO_ANTHROPIC_API_KEY=
MENGO_GOOGLE_API_KEY=
MENGO_GOOGLE_APPLICATION_CREDENTIALS=
MENGO_DEEPGRAM_API_KEY=
MENGO_ELEVENLABS_API_KEY=
# AWS-native Bedrock/Transcribe/Polly use an ECS task role, never static access keys.
MENGO_AWS_REGION=
MENGO_AWS_IAM_AUTH_ENABLED=false
MENGO_BEDROCK_MODEL_ID=
MENGO_POSTHOG_API_KEY=
MENGO_POSTHOG_HOST=
